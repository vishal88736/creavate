# Phase 0 only. Copy to .env.phase0 and keep values private.
# No Google, Supabase or LLM credential is required by this protocol probe.
# Slack tokens below are optional local staging values for the operator;
# they are not Switch Core environment variables and the probe does not read them.
SWITCH_BASE_URL=http://127.0.0.1:18000
SWITCH_SPIKE_NAME=creavate-phase0-probe
# Personal registration key from the running Switch Gateway API Keys page.
SWITCH_REGISTRATION_KEY=
# Switch room UUID, not the Slack channel ID.
SWITCH_ROOM_ID=
# Opaque Switch sender ID for the creator's linked Slack identity.
# Obtain it from actual room history after registering and inviting the probe.
SWITCH_EXPECTED_SENDER_ID=
# Human operator ID/name used to record the disposable test grant.
PHASE0_OPERATOR=
# A UUID supplied to approve/register/listen commands.
PHASE0_APPROVAL_ID=

# Optional operator staging for the real Slack connection; leave out of chat.
SLACK_WORKSPACE_ID=
SLACK_CHANNEL_ID=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
