# Creavate developer settings. Run npm run env:init to create a private .env.
# End users connect Google and Slack from Profile → Connections.
# Never put secret values in VITE_* variables or commit .env.
NODE_ENV=development
PORT=8787
WEB_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8787
APP_SECRET=
TOKEN_ENCRYPTION_KEY=

# Supabase: PostgreSQL connection/pooler URL, HTTPS project URL, PUBLIC publishable key.
# DATABASE_URL stays server-side. Use a fresh development project for migrations.
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Single creator workspace per agent-host deployment. Set your verified sign-in email.
CREATOR_EMAIL=
CREATOR_AUTH_USER_ID=

# Google OAuth web client. Authorize the callback below in Google Cloud.
# Also configure Google sign-in in Supabase with its own documented callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/oauth/google/callback
GOOGLE_DRIVE_READ_ALL=false
GOOGLE_DRIVE_PARENT_ID=
GOOGLE_CALENDAR_ID=primary
MAX_ATTACHMENT_BYTES=10000000

# Slack OAuth app settings. Use the exported Switch manifest as the starting point.
# Add this OAuth callback in the Slack app. Users install/authorize from Profile.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:8787/oauth/slack/callback
# App-level xapp token with connections:write, held only by Switch's bridge.
SLACK_APP_TOKEN=
# Optional manually provisioned connection; website OAuth is preferred.
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
SLACK_CHANNEL_ID=
CREATOR_SLACK_USER_ID=
CREATOR_SWITCH_SENDER_ID=

# Switch source pin is documented in SWITCH_INTEGRATION.md.
# Personal registration key owns the three agent identities; never use a guessed SDK.
SWITCH_BASE_URL=http://127.0.0.1:18000
SWITCH_REGISTRATION_KEY=
SWITCH_GATEWAY_EMAIL=
SWITCH_GATEWAY_PASSWORD=
# Optional pre-provisioned room/identities. Website setup can store issued keys encrypted.
SWITCH_ROOM_ID=
SWITCH_TALENT_ID=
SWITCH_TALENT_KEY=
SWITCH_BRAND_ID=
SWITCH_BRAND_KEY=
SWITCH_CAMPAIGN_ID=
SWITCH_CAMPAIGN_KEY=

# OpenCode 1.19-compatible CLI/config, as inspected in the pinned Switch source.
# Point OPENCODE_BIN to that verified binary rather than an auto-updating launcher.
LLM_PROVIDER=opencode
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/big-pickle
AGENT_TIMEOUT_SECONDS=240
MAX_AGENT_TOOL_CALLS=40
MAX_TASK_HOPS=6
APPROVAL_TTL_HOURS=24
ENABLE_WORKERS=false

# Gmail ingestion. manual is available for isolated E2E batches. Polling works without public ingress. Push requires OIDC-authenticated Pub/Sub.
GMAIL_INGESTION_MODE=poll
GMAIL_POLL_SECONDS=120
GMAIL_LOOKBACK_DAYS=7
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Optional LIVE integration/E2E tests. These never enable mocks in the application.
RUN_LIVE_TESTS=false
TEST_DATABASE_URL=
E2E_API_URL=http://127.0.0.1:8787
E2E_EMAIL=
E2E_PASSWORD=
# Two independent sets of four REAL Gmail message IDs: good,bad,ambiguous,injection.
E2E_MESSAGE_IDS_RUN1=
E2E_MESSAGE_IDS_RUN2=
